{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "operational-decision-intelligence-platform",

  "main": "./cloudflare-worker.mjs",

  "compatibility_date": "2026-08-20",

  "observability": {
    "enabled": true
  },

  "vars": {
    "AI_ENABLED": "true"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
