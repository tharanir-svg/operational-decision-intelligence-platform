{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "operational-decision-intelligence-platform",

  "main": "./cloudflare-worker.mjs",

  "compatibility_date": "2026-08-20",

  "observability": {
    "enabled": true
  },

  "vars": {
    "AI_ENABLED": "true"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "find_additional_modules": true,

"base_dir": ".",

"preserve_file_names": true,

"rules": [
  {
    "type": "Data",
    "globs": [
      "knowledge/**/*.json",
      "src/knowledge/**/*.json"
    ],
    "fallthrough": false
  },
  {
    "type": "Text",
    "globs": [
      "__odip_no_text_modules__/**/*.txt"
    ],
    "fallthrough": false
  },
  {
    "type": "CompiledWasm",
    "globs": [
      "__odip_no_wasm_modules__/**/*.wasm"
    ],
    "fallthrough": false
  }
]
}