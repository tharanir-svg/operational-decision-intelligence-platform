{
  "version": "1.0.1",
  "description": "Operational Risk Factor Library",

  "riskFactors": [

    {
      "id": "RF-001",
      "name": "Extreme Fatality Count",
      "rule": {
        "field": "intelligence.casualties.fatalities",
        "operator": "greaterThanOrEqual",
        "value": 20
      },
      "points": 40,
      "reason": "20 or more fatalities indicate an extreme casualty event."
    },

    {
      "id": "RF-002",
      "name": "Mass Casualty Event",
      "rule": {
        "field": "intelligence.casualties.fatalities",
        "operator": "greaterThanOrEqual",
        "value": 10
      },
      "points": 15,
      "reason": "10 or more fatalities indicate a mass casualty event."
    },

    {
      "id": "RF-003",
      "name": "Government Facility Target",
      "rule": {
        "field": "intelligence.infrastructure",
        "operator": "contains",
        "value": "The White House"
      },
      "points": 25,
      "reason": "A government facility is identified as a critical target."
    },

    {
      "id": "RF-004",
      "name": "Terrorism Baseline",
      "rule": {
        "field": "intelligence.domain",
        "operator": "equals",
        "value": "Terrorism"
      },
      "points": 20,
      "reason": "Terrorism-domain events receive a baseline operational risk factor."
    },

    {
      "id": "RF-005",
      "name": "Critical Infrastructure Identified",
      "rule": {
        "any": [
          {
            "field": "intelligence.infrastructure",
            "operator": "contains",
            "value": "The White House"
          },
          {
            "field": "intelligence.infrastructure",
            "operator": "contains",
            "value": "Power Grid"
          },
          {
            "field": "intelligence.infrastructure",
            "operator": "contains",
            "value": "Airport"
          },
          {
            "field": "intelligence.infrastructure",
            "operator": "contains",
            "value": "Stadium"
          }
        ]
      },
      "points": 10,
      "reason": "A predefined critical infrastructure asset is identified."
    }

  ]
}